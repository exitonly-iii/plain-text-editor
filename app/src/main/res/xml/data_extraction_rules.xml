<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 及以上使用的“数据提取规则”。
  同样选择不备份、不迁移，文件只留在本机。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
    </device-transfer>
</data-extraction-rules>
